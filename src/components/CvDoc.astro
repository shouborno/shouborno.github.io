---
// The CV body, shared by the full CV and its tailored variants.
// `interests` replaces the research interests line; everything else comes
// from the same YAML and BibTeX as the website.
import "../styles/global.css";
import "../styles/print.css";
import { profile, publications, month } from "../lib/data.js";
import { authors, venue } from "../lib/bib.js";

const { interests = profile.research_interests, title = `${profile.full_name} CV` } = Astro.props;
const span = (s, e) => `${month(s)} – ${month(e)}`.replace("present", "Present");
const papers = publications.filter((p) => !["misc", "mastersthesis"].includes(p.type));
const patents = publications.filter((p) => p.type === "misc");
const host = profile.links;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap" rel="stylesheet" />
</head>
<body class="cv">
  <header class="head">
    <h1>{profile.name}</h1>
    <p class="headline">{profile.role}, {profile.institution}</p>
    <p class="contact">
      <a href={`mailto:${profile.email}`}>{profile.email}</a><span class="sep" />
      {profile.phone}<span class="sep" />
      <a href="https://shouborno.github.io">shouborno.github.io</a><span class="sep" />
      <a href={host.scholar}>Google Scholar</a><span class="sep" />
      <a href={host.github}>GitHub</a><span class="sep" />
      <a href={host.linkedin}>LinkedIn</a>
    </p>
  </header>

  <section>
    <h2>Research interests</h2>
    <p class="summary">{interests}</p>
  </section>

  <section>
    <h2>Education</h2>
    {profile.education.map((x) => (
      <div class="entry">
        <div class="row"><span><strong>{x.degree}</strong><span class="sub">, {x.school}</span></span><span class="date">{span(x.start, x.end)}{x.expected ? " (expected)" : ""}</span></div>
        {x.detail && <p class="detail">{x.detail}</p>}
      </div>
    ))}
  </section>

  <section>
    <h2>Experience</h2>
    {profile.experience.map((x) => (
      <div class="entry">
        <div class="row"><span><strong>{x.title}, {x.org}</strong><span class="sub">, {x.place}</span></span><span class="date">{span(x.start, x.end)}</span></div>
        <ul>{x.points.map((p) => <li>{p}</li>)}</ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Publications</h2>
    <ol class="pubs" reversed>
      {papers.map((p) => (
        <li>
          {authors(p, profile.self_names).map((a, i, all) => (
            <Fragment>{a.self ? <strong>{a.name}</strong> : a.name}{i < all.length - 1 ? ", " : ". "}</Fragment>
          ))}
          <span class="ptitle">{p.title}.</span>{" "}
          <em>{venue(p)}</em>{p.pages ? `, pp. ${p.pages}` : ""}{p.status ? "" : `, ${p.year}`}.
          {p.status === "under review" && <span class="flag"> Under review.</span>}
          {p.status === "accepted" && <span class="flag"> Accepted, {p.year}.</span>}
        </li>
      ))}
    </ol>
  </section>

  <section>
    <h2>Patent</h2>
    {patents.map((p) => (
      <p class="plain">
        {authors(p, profile.self_names).map((a, i, all) => (
          <Fragment>{a.self ? <strong>{a.name}</strong> : a.name}{i < all.length - 1 ? ", " : ". "}</Fragment>
        ))}
        <span class="ptitle">{p.title}.</span> {p.howpublished}, {p.year}.
      </p>
    ))}
  </section>

  <section>
    <h2>Honors and awards</h2>
    {profile.awards.map((a) => <div class="row line"><span>{a.text}</span><span class="date">{a.year}</span></div>)}
  </section>

  <section>
    <h2>Service</h2>
    {profile.service.map((s) => <div class="row line"><span>{s.text}</span><span class="date">{s.years.replace(" to ", " – ")}</span></div>)}
  </section>

  <section>
    <h2>Skills</h2>
    {profile.skills.map((s) => <p class="plain"><strong>{s.group}:</strong> {s.items}</p>)}
  </section>
</body>
</html>
