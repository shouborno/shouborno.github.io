---
// Print source for public/cv.pdf. Not linked from the site; scripts/make_cv.py
// prints it to PDF with headless Chromium. Reads the same data as the site.
import "../styles/global.css";
import { profile, publications, month } from "../lib/data.js";
import { authors, venue } from "../lib/bib.js";

const span = (s, e) => `${month(s)} – ${month(e)}`.replace("present", "Present");
const papers = publications.filter((p) => !["misc", "mastersthesis"].includes(p.type));
const patents = publications.filter((p) => p.type === "misc");
const host = profile.links;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <title>{profile.full_name} CV</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap" rel="stylesheet" />
</head>
<body class="cv">
  <header class="head">
    <h1>{profile.name}</h1>
    <p class="headline">{profile.role}, {profile.institution}</p>
    <p class="contact">
      <a href={`mailto:${profile.email}`}>{profile.email}</a><span class="sep" />
      {profile.phone}<span class="sep" />
      <a href="https://shouborno.github.io">shouborno.github.io</a><span class="sep" />
      <a href={host.scholar}>Google Scholar</a><span class="sep" />
      <a href={host.github}>GitHub</a><span class="sep" />
      <a href={host.linkedin}>LinkedIn</a>
    </p>
  </header>

  <section>
    <h2>Research interests</h2>
    <p class="summary">{profile.research_interests}</p>
  </section>

  <section>
    <h2>Education</h2>
    {profile.education.map((x) => (
      <div class="entry">
        <div class="row"><span><strong>{x.degree}</strong><span class="sub">, {x.school}</span></span><span class="date">{span(x.start, x.end)}{x.expected ? " (expected)" : ""}</span></div>
        {x.detail && <p class="detail">{x.detail}</p>}
      </div>
    ))}
  </section>

  <section>
    <h2>Experience</h2>
    {profile.experience.map((x) => (
      <div class="entry">
        <div class="row"><span><strong>{x.title}, {x.org}</strong><span class="sub">, {x.place}</span></span><span class="date">{span(x.start, x.end)}</span></div>
        <ul>{x.points.map((p) => <li>{p}</li>)}</ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Publications</h2>
    <ol class="pubs" reversed>
      {papers.map((p) => (
        <li>
          {authors(p, profile.self_names).map((a, i, all) => (
            <Fragment>{a.self ? <strong>{a.name}</strong> : a.name}{i < all.length - 1 ? ", " : ". "}</Fragment>
          ))}
          <span class="ptitle">{p.title}.</span>{" "}
          <em>{venue(p)}</em>{p.pages ? `, pp. ${p.pages}` : ""}{p.status ? "" : `, ${p.year}`}.
          {p.status === "under review" && <span class="flag"> Under review.</span>}
          {p.status === "accepted" && <span class="flag"> Accepted, {p.year}.</span>}
        </li>
      ))}
    </ol>
  </section>

  <section>
    <h2>Patent</h2>
    {patents.map((p) => (
      <p class="plain">
        {authors(p, profile.self_names).map((a, i, all) => (
          <Fragment>{a.self ? <strong>{a.name}</strong> : a.name}{i < all.length - 1 ? ", " : ". "}</Fragment>
        ))}
        <span class="ptitle">{p.title}.</span> {p.howpublished}, {p.year}.
      </p>
    ))}
  </section>

  <section>
    <h2>Honors and awards</h2>
    {profile.awards.map((a) => <div class="row line"><span>{a.text}</span><span class="date">{a.year}</span></div>)}
  </section>

  <section>
    <h2>Service</h2>
    {profile.service.map((s) => <div class="row line"><span>{s.text}</span><span class="date">{s.years.replace(" to ", " – ")}</span></div>)}
  </section>

  <section>
    <h2>Skills</h2>
    {profile.skills.map((s) => <p class="plain"><strong>{s.group}:</strong> {s.items}</p>)}
  </section>
</body>
</html>

<style is:global>
  @page { size: Letter; margin: 0.45in 0.55in; }
  body.cv {
    max-width: 7.4in; margin: 0 auto; padding: 0;
    font-size: 9.1pt; line-height: 1.3; color: #1c2430; background: #fff;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .cv a { color: inherit; text-decoration: none; }
  .cv .head { text-align: center; padding-bottom: 6pt; border-bottom: 1.5pt solid #b0174f; }
  .cv h1 { font-size: 22pt; letter-spacing: 0; margin: 0; }
  .cv .headline { font-family: var(--ui); font-size: 10pt; margin: 2pt auto 3pt; max-width: none; color: #5b6573; }
  .cv .contact { font-family: var(--ui); font-size: 8.6pt; margin: 0 auto; max-width: none; }
  .cv .sep::before { content: "|"; color: #c9b9be; margin: 0 5pt; }
  .cv h2 {
    font-size: 10.8pt; margin: 9pt 0 3pt; padding-bottom: 2pt;
    border-bottom: 0.75pt solid #d8cfd2; color: #b0174f; letter-spacing: 0.01em; break-after: avoid;
  }
  .cv p { max-width: none; }
  .cv .summary { margin: 0; }
  .cv .entry { margin: 0 0 4pt; break-inside: avoid; }
  .cv .row { display: flex; justify-content: space-between; gap: 12pt; align-items: baseline; }
  .cv .row strong { font-weight: 600; }
  .cv .date { font-size: 8.8pt; color: #5b6573; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .cv .sub { font-style: italic; color: #5b6573; }
  .cv .detail { margin: 1pt 0 0; }
  .cv ul { margin: 2pt 0 0; padding-left: 13pt; }
  .cv li { margin: 0 0 1pt; }
  .cv .pubs { margin: 0; padding-left: 20pt; }
  .cv .pubs li { margin: 0 0 3pt; break-inside: avoid; }
  .cv .pubs li::marker { font-size: 8.6pt; color: #5b6573; }
  .cv .ptitle { font-weight: 600; }
  .cv .flag { color: #b0174f; font-style: italic; }
  .cv .line { margin: 0 0 2pt; break-inside: avoid; }
  .cv .plain { margin: 0 0 2pt; }
</style>
