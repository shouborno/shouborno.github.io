---
import Base from "../layouts/Base.astro";
import Pub from "../components/Pub.astro";
import { profile, publications } from "../lib/data.js";
---
<Base title="Research">
  <header class="page-head">
    <h1>Research</h1>
    <p>My work asks what a model can reliably infer from sensors that do not measure the target directly. I apply it to wearable health and to industrial control, and two supporting lines of work, explaining sensor data in language and running models on small devices, make those models easier to check and to deploy.</p>
  </header>
  {profile.directions.map((d, i, all) => {
    const pubs = publications.filter((p) => p.topic === d.id);
    return (
      <section id={d.id} class="direction">
        {d.kind !== all[i - 1]?.kind && <p class="kind ui">{d.kind === "application" ? "Application" : "Supporting method"}</p>}
        <h2>{d.title}</h2>
        <p class="summary">{d.summary}</p>
        <p>{d.body}</p>
        {pubs.length > 0 && (
          <ul class="dated">
            {pubs.map((p) => (
              <li><span class="when">{p.status === "under review" ? "Under review" : p.year}</span><Pub pub={p} /></li>
            ))}
          </ul>
        )}
      </section>
    );
  })}
</Base>

<style>
  .direction { scroll-margin-top: 1rem; border-top: 2px solid var(--grid); margin-top: 2.5rem; }
  .direction h2 { margin-top: 1.25rem; }
  .kind { margin: 1rem 0 -0.75rem; font-size: 0.85rem; color: var(--trace); }
  .summary { font-style: italic; color: var(--muted); }
</style>
